# Keep existing values and key files on an upgrade. Never replace encryption keys casually.
SECRET_KEY=replace-with-at-least-32-random-characters
MONGO_URI=mongodb://mongo:27017/syntal_identity
MONGO_DB=syntal_identity
REDIS_URL=redis://redis:6379/0
PUBLIC_BASE_URL=https://sso.syntal.pro
OIDC_ISSUER=https://sso.syntal.pro
OIDC_PRIVATE_KEY_FILE=/app/instance/oidc_private.pem
ACCOUNT_SECRET_ENCRYPTION_KEY=replace-with-base64url-encoded-32-byte-key
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
ACCESS_TOKEN_TTL=300
ID_TOKEN_TTL=300
REFRESH_TOKEN_TTL=2592000
SESSION_MAX_AGE=43200
STEP_UP_MAX_AGE=300
# Only for an intentional legacy symmetric-key deployment:
OIDC_ALLOW_HS256=false
OIDC_HS256_SECRET=
# Explicit temporary API-audience compatibility for newly issued v3.3 access tokens:
LEGACY_API_CLIENT_IDS=
STRIPE_WEBHOOK_SECRET=
